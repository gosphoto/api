# Local secrets — never commit. CI writes this on the VPS from GitHub Actions secrets.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Tochka acquiring (pay-per-result). Empty token → stub client.
TOCHKA_ACCESS_TOKEN=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_API_BASE_URL=https://enter.tochka.com
PUBLIC_BASE_URL=https://gosphoto.ru
PRICE_KOPECKS=10000
FREE_DOWNLOAD_UNLOCK=0
PAYMENT_SYNC_INTERVAL_SECONDS=30
PAYMENTS_DIR=./payments
