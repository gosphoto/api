# Local secrets — never commit. CI writes this on the VPS from GitHub Actions secrets.
OPENROUTER_API_KEY=
EDIT_BACKEND=riverflow
RIVERFLOW_MODEL=google/gemini-2.5-flash-image
RIVERFLOW_PRO_MODEL=sourceful/riverflow-v2.5-pro
EDIT_ROUTE_PRO_ON_MESSY_HAIR=0
RIVERFLOW_BG_MODE=solid
RIVERFLOW_BG_HEX=#FFFFFF
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Tochka acquiring (pay-per-result). Empty token → stub client.
TOCHKA_ACCESS_TOKEN=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_API_BASE_URL=https://enter.tochka.com
PUBLIC_BASE_URL=https://gosphoto.ru
PRICE_KOPECKS=15000
FREE_DOWNLOAD_UNLOCK=0
PAYMENT_SYNC_INTERVAL_SECONDS=30
PAYMENTS_DIR=./payments

# Resume suit upsell (experimental)
RESUME_UPSELL_ENABLED=1
RESUME_PRICE_KOPECKS=30000
POSE_MODEL_PATH=./models/pose_landmarker_lite.task
TORSO_MIN_VISIBILITY=0.45
TORSO_MIN_SHOULDER_DROP=0.06
TORSO_MIN_SHOULDER_WIDTH=0.12
